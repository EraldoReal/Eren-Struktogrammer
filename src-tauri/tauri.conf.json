{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eren Struktogrammer",
  "version": "1.2.2",
  "identifier": "de.hus.struktogrammer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eren Struktogrammer",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "stgr"
        ],
        "name": "HuS Struktogramm",
        "description": "HuS Struktogramm Diagramm (DIN 66261)",
        "mimeType": "application/x-hus-struktogramm",
        "role": "Editor"
      },
      {
        "ext": [
          "stgp"
        ],
        "name": "HuS Struktogramm Projekt",
        "description": "HuS Struktogramm Projektdatei",
        "mimeType": "application/x-hus-struktogramm-project",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyQzNBN0VFRjNGNEYwM0QKUldROThQVHo3cWZEb2wxZnZuQ2lDNUczVGFQVGNUY0o4YTZ4TzRJYXVmZGY1bDV1ZXMxTXJkcjUK",
      "endpoints": [
        "https://github.com/EraldoReal/Eren-Struktogrammer/releases/latest/download/latest.json"
      ]
    }
  }
}
